# Runtime Environment Configuration
NODE_ENV=development
PORT=5000
DATABASE_PATH=./data/pos.db

# Comma-separated list of allowed browser origins for CORS and CSRF Origin checks
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Required in production (minimum 32 random characters each).
# Generate strong 64-char hex keys via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-chars-cryptographic-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-chars-cryptographic-refresh-secret
CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-chars-cryptographic-aes-encryption-key

# Optional initial database seed overrides (applied only when database is empty)
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CASHIER_PASSWORD=
# SEED_BARISTA_PASSWORD=
# SEED_MANAGER_PIN=
