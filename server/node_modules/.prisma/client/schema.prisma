generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  BARISTA
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DIRTY
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  ABA_KHQR
  BAKONG
  WING
  ACLEDA
  MIXED
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CASHIER)
  phone        String?
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  auditLogs AuditLog[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String              @id @default(uuid())
  name         String
  description  String?
  sku          String              @unique
  barcode      String?             @unique
  categoryId   String
  category     Category            @relation(fields: [categoryId], references: [id])
  costPrice    Decimal             @db.Decimal(10, 2)
  sellingPrice Decimal             @db.Decimal(10, 2)
  image        String?
  isAvailable  Boolean             @default(true)
  variants     ProductVariant[]
  ingredients  ProductIngredient[]
  orderItems   OrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // Small, Medium, Large
  priceOffset Decimal @default(0) @db.Decimal(10, 2)
  sku         String?
}

model ExtraTopping {
  id          String  @id @default(uuid())
  name        String
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)
}

model Ingredient {
  id            String                 @id @default(uuid())
  name          String
  unit          String // g, ml, pcs
  currentStock  Decimal                @db.Decimal(10, 2)
  minStockAlert Decimal                @db.Decimal(10, 2)
  costPerUnit   Decimal                @db.Decimal(10, 2)
  products      ProductIngredient[]
  transactions  InventoryTransaction[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model ProductIngredient {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])
  quantityRequired Decimal    @db.Decimal(10, 2)
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  createdAt     DateTime @default(now())
}

model InventoryTransaction {
  id           String               @id @default(uuid())
  ingredientId String
  ingredient   Ingredient           @relation(fields: [ingredientId], references: [id])
  type         StockTransactionType
  quantity     Decimal              @db.Decimal(10, 2)
  reason       String?
  createdById  String?
  createdAt    DateTime             @default(now())
}

model Customer {
  id            String       @id @default(uuid())
  name          String
  phone         String       @unique
  email         String?
  loyaltyPoints Int          @default(0)
  tier          String       @default("Bronze") // Bronze, Silver, Gold, Platinum
  birthday      DateTime?
  orders        Order[]
  loyaltyLogs   LoyaltyLog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model LoyaltyLog {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  pointsDelta Int
  reason      String
  createdAt   DateTime @default(now())
}

model DiningTable {
  id           String        @id @default(uuid())
  tableNumber  String        @unique
  name         String
  capacity     Int
  status       TableStatus   @default(AVAILABLE)
  floorSection String        @default("Main Floor") // Main Floor, Terrace, VIP Lounge
  orders       Order[]
  reservations Reservation[]
}

model Reservation {
  id              String      @id @default(uuid())
  tableId         String
  table           DiningTable @relation(fields: [tableId], references: [id])
  customerName    String
  phone           String
  partySize       Int
  reservationTime DateTime
  status          String      @default("Confirmed")
  createdAt       DateTime    @default(now())
}

model Order {
  id          String       @id @default(uuid())
  orderNumber String       @unique
  type        OrderType    @default(DINE_IN)
  status      OrderStatus  @default(PENDING)
  tableId     String?
  table       DiningTable? @relation(fields: [tableId], references: [id])
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  couponCode     String?
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  serviceCharge  Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)
  notes          String?

  items     OrderItem[]
  payments  Payment[]
  receipts  Receipt[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  variantName String? // e.g. Large
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  toppings    String? // JSON string or comma-separated topping names
  notes       String?
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  amountPaid    Decimal       @db.Decimal(10, 2)
  changeAmount  Decimal       @default(0) @db.Decimal(10, 2)
  transactionId String?
  createdAt     DateTime      @default(now())
}

model Receipt {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  receiptNumber String   @unique
  printedCount  Int      @default(1)
  khqrPayload   String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}
